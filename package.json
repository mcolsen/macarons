{
  "name": "@macarons/monorepo",
  "version": "0.0.0",
  "description": "Macarons, a suite of plugins for OpenCode",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "plugins/*",
    "libraries/*",
    "tools/*",
    "tests/e2e",
    "tests/repo"
  ],
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "2.1.4",
    "browserslist": "4.28.8",
    "toml": "4.2.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run lint typecheck test build",
    "setup": "bun run --cwd tools/installer start",
    "e2e": "bun run --cwd tests/e2e e2e",
    "e2e:install": "bun run --cwd tests/e2e e2e:install",
    "e2e:server": "bun run --cwd tests/e2e e2e:server",
    "e2e:tui": "bun run --cwd tests/e2e e2e:tui",
    "e2e:tui:gating": "bun run --cwd tests/e2e e2e:tui:gating",
    "e2e:tui:standalone": "bun run --cwd tests/e2e e2e:tui:standalone",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "turbo": "2.10.12"
  }
}
