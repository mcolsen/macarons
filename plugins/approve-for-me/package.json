{
  "name": "@macarons/approve-for-me",
  "version": "0.2.0",
  "description": "OpenCode v2 model-based review of eligible low and medium risk permission requests with guarded local controls",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./shared": "./src/shared.ts",
    "./interop": "./src/interop.ts"
  },
  "files": [
    "LICENSE",
    "index.ts",
    "tui.tsx",
    "src",
    "skills"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outfile=dist/approve-for-me.js",
    "lint": "biome check src test",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "opencode": ">=2.0.29 <3.0.0"
  },
  "dependencies": {
    "@macarons/permission-rules": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "@opencode/plugin": "2.0.29",
    "effect": "4.0.1"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "permissions"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@macarons/plugin-test-harness": "workspace:*",
    "@opentui/core": "0.5.17",
    "@opentui/keymap": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "solid-js": "1.9.15",
    "typescript": "^7.0.2",
    "@opencode/client": "2.0.29",
    "@opencode/theme": "2.0.29"
  }
}
