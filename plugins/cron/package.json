{
  "name": "@macarons/cron",
  "version": "0.2.0",
  "description": "OpenCode v2 one-shot and recurring reminders delivered through the native session queue",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "files": [
    "LICENSE",
    "src",
    "index.ts"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=bun --external @opencode/plugin --external effect --outfile=dist/cron.js",
    "lint": "biome check src test",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "opencode": ">=2.0.29 <3.0.0"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "@opencode/plugin": "2.0.29",
    "effect": "4.0.1",
    "@macarons/permission-rules": "workspace:*"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cron",
    "scheduled-tasks"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "@opencode/client": "2.0.29"
  }
}
