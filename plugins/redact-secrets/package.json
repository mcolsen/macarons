{
  "name": "@macarons/redact-secrets",
  "version": "0.2.0",
  "description": "OpenCode v2 secret redaction for session model requests, with local tool argument restoration",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "files": [
    "LICENSE",
    "index.ts",
    "src",
    "vendor"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=bun --packages=external --outfile=dist/redact-secrets.js",
    "lint": "biome check src test scripts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "vendor": "bun scripts/vendor-rules.ts"
  },
  "engines": {
    "opencode": ">=2.0.29 <3.0.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "secrets",
    "redaction",
    "security"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "2.0.29",
    "@opencode/ai": "2.0.29",
    "@macarons/permission-rules": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
