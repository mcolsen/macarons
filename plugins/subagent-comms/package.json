{
  "name": "@macarons/subagent-comms",
  "version": "0.1.0",
  "description": "OpenCode plugin for background subagent communication with provider-catalog model and variant selection",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "files": [
    "LICENSE",
    "src"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outfile=dist/subagent-comms.js",
    "lint": "biome check src test",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "opencode": ">=1.17.14 <2.0.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "subagents",
    "task"
  ],
  "license": "MIT",
  "dependencies": {
    "@macarons/permission-rules": "workspace:*",
    "@opencode-ai/plugin": "1.18.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@macarons/plugin-test-harness": "workspace:*",
    "@opencode-ai/sdk": "1.18.14",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
