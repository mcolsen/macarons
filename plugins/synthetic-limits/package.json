{
  "name": "@macarons/synthetic-limits",
  "version": "0.2.0",
  "description": "OpenCode v2 server-authenticated Synthetic subscription quota and regeneration widget",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "LICENSE",
    "src",
    "server.ts",
    "tui.ts"
  ],
  "scripts": {
    "lint": "biome check src test",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target=bun --outfile=dist/synthetic-limits.js"
  },
  "engines": {
    "opencode": ">=2.0.29 <3.0.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "synthetic",
    "rate-limits"
  ],
  "license": "MIT",
  "dependencies": {
    "@macarons/permission-rules": "workspace:*",
    "@macarons/usage-limits": "workspace:*",
    "@opencode/plugin": "2.0.29"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@macarons/plugin-test-harness": "workspace:*",
    "@opentui/core": "0.5.17",
    "@opentui/keymap": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "solid-js": "1.9.15",
    "typescript": "^7.0.2",
    "@opencode/client": "2.0.29",
    "@opencode/theme": "2.0.29"
  },
  "main": "./src/index.ts"
}
