{
  "name": "@macarons/web-search",
  "version": "0.2.0",
  "description": "OpenCode v2 SearXNG integration and same-provider native search; preserves built-in search selection and consent",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "files": [
    "LICENSE",
    "src",
    "NOTICE",
    "index.ts"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outfile=dist/web-search.js",
    "lint": "biome check src test",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "opencode": ">=2.0.29 <3.0.0"
  },
  "dependencies": {
    "@macarons/permission-rules": "workspace:*",
    "@opencode/plugin": "2.0.29"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "websearch",
    "searxng"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "@opencode/client": "2.0.29"
  }
}
