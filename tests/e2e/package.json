{
  "name": "@macarons/e2e",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "e2e": "bun run e2e:server && bun run e2e:install",
    "e2e:server": "bun test v2/server.e2e.test.ts --max-concurrency=1 --timeout 120000",
    "e2e:install": "bun test v2/install.e2e.test.ts --max-concurrency=1 --timeout 120000",
    "e2e:tui": "bun test v2/tui.e2e.test.ts --max-concurrency=1 --timeout 120000",
    "e2e:tui:gating": "bun run e2e:tui",
    "e2e:tui:standalone": "bun run e2e:tui",
    "lint": "biome check v2",
    "test": "bun test v2/harness.test.ts --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "@opencode/client": "2.0.29",
    "@opencode/plugin": "2.0.29"
  }
}
